% --------------------------------------------------------
% Titles (chapters, sections, subsections, subsubsections)
% --------------------------------------------------------
% Bee ornament read from the path of figs/bee.svg and filled with \MasterColor.
% Limits: one path, one colour, 'd' on one line, 634 x 453 bp page (Inkscape
% export of this bee); another SVG needs its own bounding box below.
\ExplSyntaxOn
\ior_new:N \g__thesis_svg_ior
\tl_new:N \g__thesis_ornament_tl
\cs_new_protected:Npn \thesis_load_svg_path:n #1
  {
    \ior_open:Nn \g__thesis_svg_ior {#1}
    \ior_str_map_inline:Nn \g__thesis_svg_ior
      {
        \regex_extract_once:nnNT { ^\s*d="([^"]*)" } {##1} \l_tmpa_seq
          {
            % Rescan so letters and spaces get their usual catcodes for svg.path
            \tl_gset_rescan:Nne \g__thesis_ornament_tl { } { \seq_item:Nn \l_tmpa_seq {2} }
            \ior_map_break:
          }
      }
    \ior_close:N \g__thesis_svg_ior
  }
\cs_new_protected:Npn \__thesis_fill_svg:n #1
  { \fill[\MasterColor, yscale=-1, scale=1.00375] svg {#1}; } % svg.path reads pt, y up
\cs_generate_variant:Nn \__thesis_fill_svg:n { V }
\NewDocumentCommand{\LoadOrnament}{m}{ \thesis_load_svg_path:n {#1} }
\NewDocumentCommand{\ornamentpicture}{}
  {
    \begin{tikzpicture}[x=1bp, y=-1bp]
      \useasboundingbox (0,0) rectangle (634,453);
      \__thesis_fill_svg:V \g__thesis_ornament_tl
    \end{tikzpicture}
  }
\ExplSyntaxOff
\LoadOrnament{figs/bee.svg}

% Bee ornament centered in the chapter's rule
\newcommand{\chapterornament}{%
    \begin{adjustbox}{max height=0.5\baselineskip}%
        \raisebox{-1.25\baselineskip}{\ornamentpicture}%
    \end{adjustbox}%
}

% Horizontal rule with centered content
\newcommand*\ruleline[1]{%
    \par\noindent\raisebox{.25ex}{%
        \makebox[\linewidth]{\hrulefill\hspace{1ex}\raisebox{-.8ex}{#1}\hspace{1ex}\hrulefill}%
    }%
}

\titleformat{\chapter}[block]{
    \Huge\color{\MasterColor}
}{\centering\@chapapp~\thechapter\\}{0pt}{\centering\ruleline{\chapterornament}\\[4pt]\centering #1}

\titleformat{\section}{
    \vspace{0mm plus 2cm}\color{\MasterColor}\LARGE
}{\thesection}{0.5em}{#1}

\titleformat{\subsection}{
    \Large\color{\MasterColor}
}{\thesubsection}{0.5em}{#1}

\titleformat{\subsubsection}{
    \vspace{0pt plus 2pt}\large\color{\MasterColor}
}{\thesubsubsection}{0.5em}{#1}

